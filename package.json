{
    "name": "transportes-portugal-api",
    "version": "2.0.0",
    "description": "",
    "private": true,
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
        "dev": "tsx watch ./src/http/server.ts",
        "prestart": "npm run build",
        "start": "node ./dist/http/server.js",
        "demo": "npm start -- --demo",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" eslint.config.mjs .husky/install.mjs",
        "lint": "eslint . --max-warnings=0 && npm run format:check && tsc --noEmit",
        "import": "node ./dist/transit/import-cli.js",
        "preimport": "npm run build",
        "test": "npm run build && node --test test/*.test.cjs",
        "prepare": "node .husky/install.mjs",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" eslint.config.mjs .husky/install.mjs",
        "lint:staged": "lint-staged"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/AndreVarandas/transportes-portugal-api.git"
    },
    "keywords": [],
    "author": "André Varandas, <andre.m.varandas@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/AndreVarandas/transportes-portugal-api/issues"
    },
    "homepage": "https://github.com/AndreVarandas/transportes-portugal-api#readme",
    "dependencies": {
        "@hono/node-server": "^2.1.11",
        "csv-parse": "^7.0.3",
        "gtfs-realtime-bindings": "^3.0.0",
        "hono": "^4.13.19",
        "swagger-ui-dist": "^5.35.1",
        "typescript": "~6.0.3",
        "yauzl": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@types/yauzl": "^3.4.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript-eslint": "^8.73.0"
    },
    "engines": {
        "node": ">=26.13.1"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts}": [
            "eslint --fix --max-warnings=0",
            "prettier --write"
        ]
    },
    "scarfSettings": {
        "enabled": false
    }
}
